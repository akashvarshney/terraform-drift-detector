# Copy to terraform.tfvars (untracked) and replace placeholders.
subscription_id                  = "00000000-0000-0000-0000-000000000000"
resource_group_name              = "rg-drift-agent"
location                         = "westeurope"
container_app_environment_id     = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-platform/providers/Microsoft.App/managedEnvironments/cae-platform"
container_image                  = "example.azurecr.io/terraform-drift-agent:0.2.0"
reader_scope_id                  = "/subscriptions/00000000-0000-0000-0000-000000000000"
key_vault_id                     = "https://example-kv.vault.azure.net"
foundry_endpoint                 = "https://example-foundry.services.ai.azure.com"
foundry_deployment               = "gpt-4o"
github_app_id                    = "123456"
github_app_installation_id       = "12345678"
github_private_key_secret_name   = "github-app-private-key"
checkout_storage_account_name    = "stcheckoutpilot"
checkout_storage_account_key     = "placeholder-storage-key"
checkout_share_name              = "pilot-checkout"
default_mode                     = "observe"
schedule_cron                    = "0 6 * * *"
dry_run                          = true
